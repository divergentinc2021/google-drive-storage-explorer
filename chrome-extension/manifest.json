{
  "manifest_version": 3,
  "name": "Google Drive Storage Explorer",
  "short_name": "Storage Explorer",
  "version": "1.0.0",
  "description": "Opens the UIZ Drive storage treemap — where the storage mass sits, and what is safe to move to the NAS.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Google Drive Storage Explorer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
